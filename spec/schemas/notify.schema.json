{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://githive.dev/spec/schemas/notify.schema.json",
  "title": "notify.* イベントの data スキーマ群",
  "description": "docs/features/notify.md の「イベント定義」表に従う。",
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9a-hjkmnp-tv-z]{26}$"
    },
    "target": {
      "type": "string",
      "description": "user:<name> / group:<name> / all のいずれか。",
      "pattern": "^(user:[^\\s@]+@[^\\s]+|group:[a-z0-9][a-z0-9-]{1,38}|all)$"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high"
      ]
    },
    "notify.post": {
      "type": "object",
      "description": "当月の jsonl に追記する。",
      "properties": {
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          },
          "minItems": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string"
            },
            "id": {
              "$ref": "#/$defs/ulid"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": true
        },
        "priority": {
          "$ref": "#/$defs/priority"
        }
      },
      "required": [
        "targets",
        "title"
      ],
      "additionalProperties": true
    },
    "notify.ack": {
      "type": "object",
      "description": "acks.json の該当エントリに actor を追加する。",
      "properties": {
        "ack_of": {
          "$ref": "#/$defs/ulid"
        }
      },
      "required": [
        "ack_of"
      ],
      "additionalProperties": true
    },
    "notify.checkpoint": {
      "type": "object",
      "description": "読み出し起点。fold はこの kind を常に無視する（実体化結果には影響しない）。ADR-0013 参照。state は {meta, collections, scratch} の 3 部構成（ADR-0016）。scratch と max_event_id は ADR-0016 で追加され、現行のツールは必ず書く。旧形式（両者を欠くもの）も妥当なデータとして受理するが、読み出しの近道には使えず全走査にフォールバックする。",
      "properties": {
        "state": {
          "type": "object",
          "description": "この時点の完全な fold 状態。meta（null 可）、collections、scratch。",
          "properties": {
            "meta": {
              "type": [
                "object",
                "null"
              ]
            },
            "collections": {
              "type": "object"
            },
            "scratch": {
              "type": "object"
            }
          },
          "additionalProperties": true
        },
        "event_count": {
          "type": "integer",
          "minimum": 0
        },
        "head": {
          "type": "string"
        },
        "max_event_id": {
          "type": "string",
          "pattern": "^[0-9a-hjkmnp-tv-z]{26}$",
          "description": "包含する全イベントの ID の最大値。読み出しの近道が成立するかの判定に使う（ADR-0016）。"
        }
      },
      "required": [
        "state",
        "event_count",
        "head"
      ],
      "additionalProperties": true
    }
  }
}
