{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://githive.dev/spec/schemas/chat.schema.json",
  "title": "chat.* イベントの data スキーマ群",
  "description": "docs/features/chat.md の「イベント定義」表に従う。",
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9a-hjkmnp-tv-z]{26}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "archived"
      ]
    },
    "chat.create": {
      "type": "object",
      "description": "スレッド作成。body があれば最初のメッセージを兼ねる。",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": true
    },
    "chat.post": {
      "type": "object",
      "description": "messages に追記する。",
      "properties": {
        "body": {
          "type": "string"
        },
        "reply_to": {
          "$ref": "#/$defs/ulid"
        },
        "supersedes": {
          "description": "既存メッセージの置換表示。省略可。",
          "$ref": "#/$defs/ulid"
        }
      },
      "required": [
        "body"
      ],
      "additionalProperties": true
    },
    "chat.edit_meta": {
      "type": "object",
      "description": "LWW 上書き。status は open / archived。",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      },
      "additionalProperties": true
    },
    "chat.checkpoint": {
      "type": "object",
      "description": "読み出し起点。fold はこの kind を常に無視する（実体化結果には影響しない）。ADR-0013 参照。state は {meta, collections, scratch} の 3 部構成（ADR-0016）。scratch と max_event_id は ADR-0016 で追加され、現行のツールは必ず書く。旧形式（両者を欠くもの）も妥当なデータとして受理するが、読み出しの近道には使えず全走査にフォールバックする。",
      "properties": {
        "state": {
          "type": "object",
          "description": "この時点の完全な fold 状態。meta（null 可）、collections、scratch。",
          "properties": {
            "meta": {
              "type": [
                "object",
                "null"
              ]
            },
            "collections": {
              "type": "object"
            },
            "scratch": {
              "type": "object"
            }
          },
          "additionalProperties": true
        },
        "event_count": {
          "type": "integer",
          "minimum": 0
        },
        "head": {
          "type": "string"
        },
        "max_event_id": {
          "type": "string",
          "pattern": "^[0-9a-hjkmnp-tv-z]{26}$",
          "description": "包含する全イベントの ID の最大値。読み出しの近道が成立するかの判定に使う（ADR-0016）。"
        }
      },
      "required": [
        "state",
        "event_count",
        "head"
      ],
      "additionalProperties": true
    }
  }
}
