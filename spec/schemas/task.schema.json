{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://githive.dev/spec/schemas/task.schema.json",
  "title": "task.* イベントの data スキーマ群",
  "description": "docs/features/task.md の「イベント定義」表に従う。",
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9a-hjkmnp-tv-z]{26}$"
    },
    "username": {
      "type": "string",
      "pattern": "^[^\\s@]+@[^\\s]+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "todo",
        "doing",
        "review",
        "done",
        "blocked",
        "cancelled"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high"
      ]
    },
    "task.create": {
      "type": "object",
      "description": "初期状態。owner 省略時は actor。",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string"
        },
        "owner": {
          "$ref": "#/$defs/username"
        },
        "due": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "priority": {
          "$ref": "#/$defs/priority"
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": true
    },
    "task.edit": {
      "type": "object",
      "description": "LWW 上書き。",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string"
        },
        "due": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "priority": {
          "$ref": "#/$defs/priority"
        }
      },
      "additionalProperties": true
    },
    "task.status": {
      "type": "object",
      "description": "遷移し status_history に追記する。note があれば notes にも追加する。",
      "properties": {
        "from": {
          "$ref": "#/$defs/status"
        },
        "to": {
          "$ref": "#/$defs/status"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "to"
      ],
      "additionalProperties": true
    },
    "task.reassign": {
      "type": "object",
      "description": "owner を上書きする（LWW）。",
      "properties": {
        "owner": {
          "$ref": "#/$defs/username"
        }
      },
      "required": [
        "owner"
      ],
      "additionalProperties": true
    },
    "task.note": {
      "type": "object",
      "description": "notes に追記する。",
      "properties": {
        "body": {
          "type": "string"
        }
      },
      "required": [
        "body"
      ],
      "additionalProperties": true
    },
    "task.link": {
      "type": "object",
      "description": "links 集合に適用する。",
      "properties": {
        "rel": {
          "type": "string",
          "enum": [
            "task",
            "issue",
            "chat"
          ]
        },
        "id": {
          "$ref": "#/$defs/ulid"
        },
        "remove": {
          "type": "boolean"
        }
      },
      "required": [
        "rel",
        "id"
      ],
      "additionalProperties": true
    },
    "task.checkpoint": {
      "type": "object",
      "description": "読み出し起点。fold はこの kind を常に無視する（実体化結果には影響しない）。ADR-0013 参照。state は {meta, collections, scratch} の 3 部構成（ADR-0016）。scratch と max_event_id は ADR-0016 で追加され、現行のツールは必ず書く。旧形式（両者を欠くもの）も妥当なデータとして受理するが、読み出しの近道には使えず全走査にフォールバックする。",
      "properties": {
        "state": {
          "type": "object",
          "description": "この時点の完全な fold 状態。meta（null 可）、collections、scratch。",
          "properties": {
            "meta": {
              "type": [
                "object",
                "null"
              ]
            },
            "collections": {
              "type": "object"
            },
            "scratch": {
              "type": "object"
            }
          },
          "additionalProperties": true
        },
        "event_count": {
          "type": "integer",
          "minimum": 0
        },
        "head": {
          "type": "string"
        },
        "max_event_id": {
          "type": "string",
          "pattern": "^[0-9a-hjkmnp-tv-z]{26}$",
          "description": "包含する全イベントの ID の最大値。読み出しの近道が成立するかの判定に使う（ADR-0016）。"
        }
      },
      "required": [
        "state",
        "event_count",
        "head"
      ],
      "additionalProperties": true
    }
  }
}
