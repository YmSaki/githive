      "v": 1,
      "kind": "notify.post",
      "id": "00003kc73gsq8p6qb2b9kbmee6",
      "ts": "2026-07-10T08:00:00.000Z",
      "actor": "a@example.com",
      "entity": "00003kc73gsq8p6qb2b9kbmee6",
      "data": {
        "targets": [
          "all"
        ],
        "title": "重要なお知らせ"
      }
    },
    {
      "v": 1,
      "kind": "notify.ack",
      "id": "00003kc73qx8nnfxr89ced6yvk",
      "ts": "2026-07-10T08:01:00.000Z",
      "actor": "z@example.com",
      "entity": "00003kc73qx8nnfxr89ced6yvk",
      "data": {
        "ack_of": "00003kc73gsq8p6qb2b9kbmee6"
      }
    },
    {
      "v": 1,
      "kind": "notify.ack",
