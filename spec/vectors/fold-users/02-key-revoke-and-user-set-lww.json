      "id": "00005d2vhpswz1v2jhmb8bqz0r",
      "ts": "2026-07-05T00:05:00.000Z",
      "actor": "admin@example.com",
      "entity": "00005d2vhpswz1v2jhmb8bqz0r",
      "data": {
        "username": "dev-agent-01",
        "pub": "ssh-ed25519 AAAAKEY1"
